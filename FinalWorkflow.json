        "messages": {
          "values": [
            {
              "content": "=You are a precise email-data-extraction assistant. Always return exactly one valid JSON object and nothing else (no explanation, no code fences). Follow the schema and rules precisely. NOTE: If the email is not a job application, return nothing.\n\nUser prompt (template — replace bracketed parts)\nExtract applicant data from the following email. Use the email headers, body text, and attachment list exactly as provided. Depending upon description set status to Applied, Interviewing, Reject, or Offer. Depending upon who sent the mail, set Source to Gmail or LinkedIn or Indeed. Put a small summary of the email in notes. Return exactly one JSON object matching this schema (use null for missing fields):\n\n{\n\"Name\": string | null,\n\"Email\": string | null,\n\"Company\": string | null,\n\"Position\": string | null,\n\"DateApplied\": string (ISO8601) | null,\n\"Source\": string | null,\n\"Status\": string | null,\n\"ResumeLink\": string | null,\n\"Notes\": string | null\n}\nHere's the email-\n{{ $json.textHtml }}{{ $json.metadata.received }}{{ $json.subject }}\nThis is who sent the email, not the receiver, use it for status only. Only check the part after @, and Retrieve every other information from above only.-> \n{{ $json.from }}"
            }
          ]
        },
        "jsonOutput": true,
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.1,
      "position": [
        336,
        -336
      ],
      "id": "cf4663b7-562b-49e9-a1bd-54bde0dd5ce5",
      "name": "Message a model",
      "credentials": {
        "googlePalmApi": {
          "id": "VMeyR2brCbZ8DCaO",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Robust n8n Function node to extract JSON from various model outputs and normalize schema\nconst input = $input.item.json;\n\n// Collect candidate text locations\nconst candidates = [];\nif (input.choices && input.choices.length) {\n  const c = input.choices[0];\n  if (c.message && c.message.content) candidates.push(c.message.content);\n  if (c.text) candidates.push(c.text);\n  if (c.content) candidates.push(c.content);\n}\nif (input.output && Array.isArray(input.output)) {\n  candidates.push(input.output.map(x => (typeof x === 'string' ? x : JSON.stringify(x))).join(' '));\n}\nif (input.content && input.content.parts && Array.isArray(input.content.parts)) {\n  input.content.parts.forEach(p => { if (p.text) candidates.push(p.text); });\n}\nif (input.generated_text) candidates.push(input.generated_text);\nif (input.text) candidates.push(input.text);\nif (input.message && input.message.content) candidates.push(input.message.content);\nif (Object.keys(input).length && candidates.length === 0) candidates.push(JSON.stringify(input));\n\n// Merge candidates into one string\nconst combined = candidates.filter(Boolean).join('\\n\\n');\n\n// Find the first JSON object in text\nfunction extractFirstJSONObject(str) {\n  const match = str.match(/{[\\s\\S]*}/);\n  if (!match) return null;\n  try {\n    return JSON.parse(match[0]);\n  } catch (e) {\n    // Try to fix common issues: unquoted keys -> give up (avoid unsafe eval)\n    return null;\n  }\n}\n\nlet parsed = extractFirstJSONObject(combined);\n\n// If not found, attempt parsing the entire string if it is pure JSON\nif (!parsed) {\n  try { parsed = JSON.parse(combined.trim()); } catch(e) { parsed = parsed || null; }\n}\n\n// Keys we require\nconst keys = [\"Name\",\"Email\",\"Company\",\"Position\",\"DateApplied\",\"Source\",\"Status\",\"ResumeLink\",\"Notes\"];\nconst out = {};\nfor (const k of keys) out[k] = null;\n\nif (parsed && typeof parsed === 'object') {\n  for (const k of keys) {\n    if (Object.prototype.hasOwnProperty.call(parsed, k)) {\n      out[k] = parsed[k] === undefined ? null : parsed[k];\n    }\n  }\n}\n\n// Normalize DateApplied to ISO8601 or null\nif (out.DateApplied) {\n  const d = new Date(out.DateApplied);\n  out.DateApplied = isNaN(d.getTime()) ? null : d.toISOString();\n}\n\nreturn [{ json: out }];"
      },
